# Arc mainnet RPC endpoint used by the server-side verifier.
# Optional. Defaults to the verified public endpoint: https://rpc.mainnet.arc.io
ARC_RPC_URL=https://rpc.mainnet.arc.io

# Expected Arc mainnet USDC (ERC-20 interface) contract address.
# Optional. Defaults to the verified value: 0x3600000000000000000000000000000000000000
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Public base URL used to build shareable payment links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon PostgreSQL connection string (Prisma). Required at runtime.
# Use the pooled connection string for serverless (Vercel). Placeholder only —
# never commit real credentials. See docs/DATABASE.md.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Optional: a separate database used only by the Prisma integration tests.
# If unset, those tests are skipped (they are skipped locally by default).
TEST_DATABASE_URL=

# Rate limiting is documented in docs/SECURITY.md and not implemented yet. Add
# per-IP limits on payment creation and verification before public deployment.
