# Arc mainnet RPC endpoint used by the server-side verifier.
# Optional. Defaults to the verified public endpoint: https://rpc.mainnet.arc.io
ARC_RPC_URL=https://rpc.mainnet.arc.io

# Expected Arc mainnet USDC (ERC-20 interface) contract address.
# Optional. Defaults to the verified value: 0x3600000000000000000000000000000000000000
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Public base URL used to build shareable payment links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Durable payment store. SQLite is used by default and needs no credentials.
# Optional. Defaults to ./data/arcpaylink.db. Point this at a persistent volume
# in production. Replay protection relies on this database's UNIQUE constraint.
DATABASE_PATH=

# Reserved for a managed Postgres deployment. Not implemented yet; a `file:`
# URL here is treated as a SQLite path. Never commit real credentials.
DATABASE_URL=

# Rate limiting is documented in docs/SECURITY.md and not implemented yet. Add
# per-IP limits on payment creation and verification before public deployment.
